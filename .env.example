# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Contact form (build step 7) — https://resend.com → API Keys.
RESEND_API_KEY=

# Inbox that receives contact-form messages (D13).
CONTACT_TO_EMAIL=

# Optional sender. Without a verified domain, Resend only allows
# onboarding@resend.dev, which can only send to the Resend account's own email.
# CONTACT_FROM_EMAIL="Portfolio contact <onboarding@resend.dev>"
